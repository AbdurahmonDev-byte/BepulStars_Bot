# Bot token (BotFather dan olinadi)
BOT_TOKEN=123456789:AAAAAAAAAAAA

# Admin Telegram ID lari (vergul bilan)
ADMIN_IDS=123456789,987654321

# Ma'lumotlar bazasi fayli (avtomatik bot.py yonida yaratiladi, o'zgartirish shart emas)
# Faqat TURSO_DATABASE_URL bo'sh bo'lganda ishlatiladi (pastga qarang).
# DB_PATH=bot.db

# Turso (bepul, doimiy tashqi baza) — Render kabi hostinglarda ma'lumotlar
# (foydalanuvchilar, balanslar, referallar, buyurtmalar) redeploy/restart'da
# YO'QOLMASLIGI uchun tavsiya etiladi. Sozlash bo'yicha TURSO_SETUP.md'ga qarang.
# Bo'sh qoldirilsa, bot lokal bot.db faylidan foydalanadi (test uchun yetarli,
# lekin Render free tarifida production uchun tavsiya etilmaydi).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Render / webhook uchun (agar bo'sh bo'lsa — polling rejimida ishlaydi)
WEBHOOK_URL=https://your-app.onrender.com
WEBHOOK_PATH=/webhook
PORT=8000

# Mini App (Telegram Web App do'kon) uchun ochiq HTTPS manzil.
# WEBHOOK_URL sozlangan bo'lsa buni alohida yozish shart emas (o'shani ishlatadi).
# Polling rejimida (WEBHOOK_URL bo'sh) Render'dagi xizmat manzilini shu yerga
# yozing, masalan: https://referalbot.onrender.com — aks holda Mini App
# tugmasi ko'rinmaydi (Telegram web_app HTTPS talab qiladi). Batafsil: MINI_APP.md.
# PUBLIC_BASE_URL=https://referalbot.onrender.com
